{
  "name": "raster",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && node --test 'scripts/*.test.mjs'",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "e2e": "pnpm --filter @raster/docs run e2e && pnpm --filter @raster/studio run e2e",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm pack-check && pnpm e2e",
    "pack-check": "node scripts/pack-check.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "node scripts/publish.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "publint": "0.3.25",
    "tsdown": "0.23.7"
  }
}
