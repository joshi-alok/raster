{
  "name": "@rasterdesign/tokens",
  "version": "0.1.0",
  "private": false,
  "description": "Raster's design tokens: two themes with light and dark modes, as CSS, JSON and design-tool files.",
  "homepage": "https://raster-docs.joshi-alok.workers.dev",
  "license": "MIT",
  "author": "Raster contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshi-alok/raster.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/joshi-alok/raster/issues",
  "keywords": [
    "design-system",
    "swiss",
    "css",
    "react",
    "design-tokens"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./design-tools/*": "./dist/design-tools/*"
  },
  "scripts": {
    "build": "tsx src/build.ts && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
